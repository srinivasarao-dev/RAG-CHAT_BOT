# Copy this file to .env and fill in what you have. Only GROQ_API_KEY is required.

# ---- Required ----
# https://console.groq.com/keys
GROQ_API_KEY=
# Optional: the server picks the best available Groq model automatically
GROQ_MODEL=openai/gpt-oss-120b

# ---- More AI providers (optional) ----
# Set these to make Claude / OpenAI available to everyone using this server. Without them, each user
# can still enter their own key in the web UI (Settings -> AI providers); those keys stay in their browser.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys  (GPT and Codex models)
OPENAI_API_KEY=

# ---- Code mode ----
# Lets Code mode (and the Run button on code blocks) execute Python on THIS machine.
# auto = on only when HOST is 127.0.0.1/localhost. Never turn it on for a public deployment.
CODE_EXECUTION=auto

# ---- Database (optional: without it, chats are saved to a local SQLite file chat_history.db) ----
# Supabase -> Project Settings -> API. URL can be the full https://<ref>.supabase.co or just the project ref.
# Use the secret key (sb_secret_... or the legacy service_role key). Server-side only, never expose it.
SUPABASE_URL=
SUPABASE_KEY=

# ---- Login (optional; required for public deployments) ----
# Supabase -> Project Settings -> API Keys -> Publishable key (sb_publishable_...). This one is public:
# the browser uses it to sign users in. Setting it turns on login (email + password) for the whole app.
SUPABASE_ANON_KEY=
# auto = login on when SUPABASE_ANON_KEY is set | on | off
AUTH=auto

# ---- Optional API keys: each tool falls back to a free keyless API/library without them ----

# Web search, tried in this order, then DuckDuckGo (free, no key)
# https://tavily.com  (1,000 free searches/month, built for LLMs)
TAVILY_API_KEY=
# https://serper.dev  (Google results, 2,500 free queries)
SERPER_API_KEY=
# https://brave.com/search/api
BRAVE_API_KEY=

# News (fallback: DuckDuckGo News, then Google News RSS) - https://newsapi.org
NEWSAPI_KEY=

# X / Twitter API v2 recent search (paid Basic tier or higher) - https://developer.x.com
# Without it, social_posts uses Bluesky + Mastodon (free) and web search for x.com posts
X_BEARER_TOKEN=
# Bluesky full-text search: your handle + an App Password (Settings -> App Passwords). Free.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Reddit official API (fallback: web search results on reddit.com) - https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=realtime-chatbot/1.0

# Real-time US stock quotes + company news (fallback: Yahoo Finance via yfinance) - https://finnhub.io
FINNHUB_API_KEY=

# GitHub token raises the search rate limit - https://github.com/settings/tokens
GITHUB_TOKEN=

# Identify your bot to websites (Wikipedia requires contact info), e.g. MyChatbot/1.0 (https://yoursite.com)
HTTP_USER_AGENT=

# ---- Server ----
# Use HOST=0.0.0.0 to allow other devices on your network (or a hosting platform) to connect
HOST=127.0.0.1
PORT=8000

# ---- Tuning ----
# Past messages sent to the model as memory
HISTORY_WINDOW=20
# Seconds to reuse a tool result before fetching again
TOOL_CACHE_TTL=120
